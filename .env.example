NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Exercise Form Correction Backend
# Use http:// for local, https:// for production
# The app auto-derives ws:// / wss:// for WebSocket connections
NEXT_PUBLIC_FORM_COACH_URL=http://localhost:8000

# AI Food Recognition (server-side only — no NEXT_PUBLIC_ prefix)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override model (default is gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash